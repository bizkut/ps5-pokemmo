# Copy to .env (which is never committed) and fill in.

# Your own portable Windows PokeMMO client: the folder that holds PokeMMO.exe.
# The client is not part of this project; tools/wine-ps5/stage-game.py copies it to the console from here.
POKEMMO_CLIENT="/path/to/PokeMMO-Client"

# The console (read by vendor/PS5_Vulkan/tools/ps5_console.py from vendor/PS5_Vulkan/.env):
# PS5_HOST, PS5_FTP_PORT, PS5_FTP_USER, PS5_FTP_PASSWORD
